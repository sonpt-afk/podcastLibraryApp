# Database (migrations: `npm run migrate`; tests use a separate DB, see vitest + implementation-notes.md)
DATABASE_URL=postgresql://user:password@localhost:5432/son_podcast_library
# MUST differ from DATABASE_URL: tests wipe tables. Migrate it with: DATABASE_URL=<this> npx node-pg-migrate up -m migrations
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/son_podcast_test

# Better Auth (Google only in P1). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_SECRET=change-me-32+-random-chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Providers: "fake" (canned, free, used by tests/e2e) or "real"
TRANSCRIBE_PROVIDER=fake
GENERATE_PROVIDER=fake
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
# Model names live in env so a provider deprecation is a config change, not a deploy
OPENAI_MODEL_MAP=gpt-6-luna
OPENAI_MODEL_CHAPTER=gpt-6.1-terra

# TEST ONLY: enables email+password sign-in for Playwright. NEVER set in production.
# E2E_AUTH=1
